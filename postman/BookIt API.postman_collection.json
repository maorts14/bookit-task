          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.json().access_token;",
                  "pm.collectionVariables.set(\"owner_token\", token);",
                  "pm.collectionVariables.set(\"bearerToken\", token);",
                  "pm.test(\"returns a bearer token\", () => pm.expect(pm.response.code).to.equal(200));"
